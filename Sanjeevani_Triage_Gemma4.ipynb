    {
      "cell_type": "code",
      "source": [
        "def triage_assistant(symptom_text):\n",
        "    if \"सिरदर्द\" in symptom_text or \"थकान\" in symptom_text:\n",
        "        return \"Green (Mild): Likely stress or dehydration.\"\n",
        "    elif \"पेट दर्द\" in symptom_text or \"उल्टी\" in symptom_text:\n",
        "        return \"Yellow (Doctor Visit): Possible infection, needs evaluation.\"\n",
        "    elif \"सांस\" in symptom_text or \"सीने में दर्द\" in symptom_text:\n",
        "        return \"Red (Emergency): Warning signs of heart/respiratory issue.\"\n",
        "    else:\n",
        "        return \"Please consult a doctor for clarification.\"\n",
        "\n",
        "# Example run\n",
        "print(triage_assistant(\"मुझे हल्का सिरदर्द और थकान है\"))\n",
        "\n"
      ],
