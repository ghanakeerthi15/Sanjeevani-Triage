      "cell_type": "code",
      "source": [
        "from google import genai\n",
        "\n",
        "# Create client\n",
        "client = genai.Client(api_key=\"YOUR API KEY")\n",
        "\n",
        "# Pick one of the Gemma models you listed\n",
        "model = \"models/gemma-4-26b-a4b-it\"   # or \"models/gemma-4-31b-it\"\n",
        "\n",
        "# Run a triage prompt\n",
        "response = client.models.generate_content(\n",
        "    model=model,\n",
        "    contents=\"Patient says: मुझे सांस लेने में कठिनाई और सीने में दर्द है. \"\n",
        "             \"Classify into Green, Yellow, or Red triage category with reason.\"\n",
        ")\n",
        "\n",
        "print(response.text)\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
